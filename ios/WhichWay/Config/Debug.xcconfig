// Debug configuration. Personal values (your Apple team, a local data server) go in Local.xcconfig next to
// this file, which git ignores; copy Local.xcconfig.example to start. Note: "//" starts a comment in an
// xcconfig, so URLs are written with the $() trick.

// Where the app starts loading the published data from (Settings can change it at run time).
WHICHWAY_BASE_URL = https:/$()/bdrumm.github.io/whichway/data/
// Where the Debug build sends recorded trips (your Mac on the home network); empty: the data server, if it is one.
WHICHWAY_TRIP_SERVER =
// The trip relay (relay/README.md): its https address and the app key it expects; set in Local.xcconfig. Empty:
// trips go to the rider's own GitHub repository if they set a token in Settings, else stay on the phone.
WHICHWAY_TRIP_RELAY =
WHICHWAY_RELAY_KEY =
PRODUCT_BUNDLE_IDENTIFIER = com.whichway.app
DEVELOPMENT_TEAM =

// Carried into the app through Config/Info.plist, which Xcode merges into the generated Info.plist
// (INFOPLIST_KEY_* only works for Xcode's own keys). Read by DataService.defaultBase.
INFOPLIST_FILE = Config/Info.plist

#include? "Local.xcconfig"
