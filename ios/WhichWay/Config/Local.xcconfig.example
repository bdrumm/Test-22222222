// Copy this file to Local.xcconfig (git-ignored) and fill in your values.

// Your Apple team id (Xcode > Settings > Accounts, or developer.apple.com) for automatic signing.
DEVELOPMENT_TEAM = ABCDE12345
// A bundle id that is yours, so automatic signing can register it.
PRODUCT_BUNDLE_IDENTIFIER = com.yourname.whichway
// The local server started with `make serve` (the Simulator reaches localhost; a device needs your Mac's
// address on the local network, e.g. http:/$()/192.168.1.20:8000/data/).
WHICHWAY_BASE_URL = http:/$()/localhost:8000/data/
